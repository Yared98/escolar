# Ambiente de execução: development | production | test
APP_ENV=development

# URL de conexão com o banco de dados PostgreSQL
# Em produção, DEVE ser configurada explicitamente e utilizar credenciais restritas.
DATABASE_URL=postgres://usuario:senha@localhost:5432/escolar_db

# Chave privada Ed25519 no formato PKCS#8 PEM para assinatura de tokens JWT
# Obrigatório em produção.
JWT_ED25519_PRIVATE_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Origens permitidas para requisições CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Porta do servidor backend HTTP REST API
PORT=8000
