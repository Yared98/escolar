DATABASE_URL=postgres://escolar_app:escolar_password@localhost:5432/escolar_db
POLL_INTERVAL_MS=3000

# Push Notifications: 'simulated' (default) ou 'vapid'
PUSH_MODE=simulated

# Web Push (VAPID) - obrigatório se PUSH_MODE=vapid (gerar com: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@escolar.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
