# Exemplo de variáveis para implantação no homelab.
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o arquivo .env — ele contém segredos.

# Domínio público onde o sistema será acessado (ex: escola.seudominio.com.br).
# O Caddy solicitará certificado HTTPS automaticamente para este domínio.
DOMINIO=escola.exemplo.com.br

# URL pública do sistema, usada para links de recuperação de senha.
APP_PUBLIC_URL=https://${DOMINIO}

# Credenciais do PostgreSQL.
POSTGRES_USER=escolar_app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=escolar_db

# Ambiente: production (escola real, sem dados de demonstração) ou demo (carrega a escola-modelo).
APP_ENV=production

# Chave Ed25519 PKCS#8 para assinar os tokens de login.
# Gere com ./gerar-chave-jwt.sh (ou: openssl genpkey -algorithm ed25519 -out segredos/jwt_private.pem).
# O compose monta ./segredos em /run/segredos (somente leitura) e lê o arquivo abaixo.
JWT_ED25519_PRIVATE_PEM_FILE=/run/segredos/jwt_private.pem

# Mostra a aba "Cadastrar Escola" no login. Use true só para criar a primeira escola e reconstrua o frontend.
PERMITIR_CADASTRO_ESCOLA=false

# true só junto com APP_ENV=demo: o login mostra atalhos para entrar como cada perfil da escola-modelo.
MODO_DEMO=false

# Limite de requisições por minuto em rotas públicas (login, refresh etc.).
RATE_LIMIT_PUBLIC_RPM=60

# Bloqueio por tentativas de login incorretas.
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_WINDOW_MINUTES=15

# Modo de integração com o banco Cora (mock / sandbox / production).
CORA_MODE=mock

# Credenciais da Cora (Integração Direta). Obtenha em Conta > Integrações via APIs no app da Cora.
# Coloque os arquivos PEM em ./segredos (montado em /run/segredos no container).
# CORA_CLIENT_ID=seu-client-id
# CORA_CERT_FILE=/run/segredos/cora_certificate.pem
# CORA_KEY_FILE=/run/segredos/cora_private_key.pem
# CORA_BASE_URL só é necessário para apontar para um simulador em teste (ex.: http://...).
# CORA_BASE_URL=

# Intervalo de sondagem do worker de notificações, em milissegundos.
POLL_INTERVAL_MS=3000

# Modo de e-mail: simulado (os e-mails ficam na caixa de saída da gestão; envio real ainda não existe).
EMAIL_MODE=simulado
